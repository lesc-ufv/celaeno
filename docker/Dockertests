# Configure Neovim
RUN if [[ ! -z "$VIM" ]] ; then \
  git clone https://github.com/VundleVim/Vundle.vim.git ~/.vim/bundle/Vundle.vim \
  && mkdir -p $HOME/.config/nvim \
  && cp -r $HOME/celaeno/doc/nvim/* $HOME/.config/nvim/ \
