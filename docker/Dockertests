# vim: set expandtab syntax=dockerfile fdm=marker ts=2 sw=2 tw=100 et :

FROM alpine:latest

# Arguments
ARG vim

# Install packages
RUN apk add --no-cache build-base ninja make cmake \
  clang git py3-pip  clang-extra-tools nnn fish sudo

# Opt vim install
RUN if [[ ! -z "$vim" ]] ; then apk add neovim nodejs npm; fi

# Install conan with pip3
RUN pip3 install -I conan

# Configure user
ARG USER=user
ENV HOME /home/$USER
RUN addgroup -g 1000 $USER
RUN adduser -u 1000 -G $USER -s /bin/fish -D $USER
RUN echo "$USER ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/$USER && chmod 0440 /etc/sudoers.d/$USER
## Change to new user
USER $USER
WORKDIR $HOME

# Configure conan
RUN conan profile new default --detect
RUN conan profile update settings.compiler.libcxx=libstdc++11 default
RUN conan remote add celaeno https://api.bintray.com/conan/ruanformigoni/celaeno

# Configure project
RUN git clone https://gitlab.com/formigoni/celaeno.git celaeno
WORKDIR $HOME/celaeno

# Install dependencies
RUN mkdir build && cd build && conan install .. --build missing && cd ..

# Configure Neovim
RUN if [[ ! -z "$vim" ]] ; then \
  git clone https://github.com/VundleVim/Vundle.vim.git ~/.vim/bundle/Vundle.vim \
  && mkdir -p $HOME/.config/nvim \
  && cp -r $HOME/celaeno/doc/nvim/* $HOME/.config/nvim/ \
  && mv $HOME/.config/nvim/vimrc $HOME/.config/nvim/init.vim \
  && nvim -c "PluginInstall" -c "qa!" \
  ; fi

# Start shell
CMD ["fish"]
