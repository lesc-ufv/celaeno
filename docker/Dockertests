FROM ubuntu:latest

# Arguments
ARG VIM
ARG DEBUG_SVG_HPP
ARG DEBUG_SHOW_ALG
ARG DEBUG_SHOW_HDL
ARG OPT_SEQ

RUN apt update && apt install -y build-essential ninja-build make cmake clang git python3-pip \
  clang-tools nnn fish sudo

# Opt vim install
RUN if [ -n "$VIM" ] ; then apt install -y neovim nodejs npm; fi

# Install conan with pip3
RUN pip3 install -I conan

# Configure user
ARG USER=user
ENV HOME /home/$USER
RUN mkdir /home/$USER
RUN groupadd $USER
RUN useradd -u 1000 -g $USER -s /bin/fish $USER
RUN echo "$USER ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/$USER && chmod 0440 /etc/sudoers.d/$USER
RUN chown -R user:user /home/user
## Change to new user
USER $USER
WORKDIR $HOME

# Configure conan
RUN conan profile new default --detect
RUN conan profile update settings.compiler.libcxx=libstdc++11 default

