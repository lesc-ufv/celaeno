FROM archlinux:latest

RUN pacman -Sy
RUN pacman -S --noconfirm archlinux-keyring
RUN rm -r /etc/pacman.d/gnupg
RUN pacman-key --init
RUN pacman-key --populate
RUN pacman -Syu --noconfirm
RUN pacman --noconfirm -S clang git ninja base-devel cmake python-pipx bash

# Configure user
ARG USER=user
ENV HOME /home/$USER
RUN mkdir /home/$USER
RUN groupadd $USER
RUN useradd -u 1000 -g $USER -s /bin/bash $USER
RUN echo "$USER ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/$USER && chmod 0440 /etc/sudoers.d/$USER
RUN chown -R user:user /home/user
## Change to new user
USER $USER
WORKDIR $HOME

