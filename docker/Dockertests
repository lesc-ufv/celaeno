FROM formigoni/alpine-gcc-10:latest

# Install packages
RUN apk add ninja make cmake clang git py3-pip
RUN pip3 install -I conan

# Configure conan
RUN conan profile new default --detect
RUN conan profile update settings.compiler.libcxx=libstdc++11 default
RUN conan remote add pleiades https://api.bintray.com/conan/ruanformigoni/pleiades
RUN conan remote add spdlog https://api.bintray.com/conan/ruanformigoni/spdlog
RUN conan remote add fmt https://api.bintray.com/conan/ruanformigoni/fmt
RUN conan remote add epfl https://api.bintray.com/conan/ruanformigoni/epfl

# Configure project
ADD ./ /celaeno/
RUN rm -rf /celaeno/build
WORKDIR /celaeno/build

# Install dependencies
RUN conan install .. --build missing

# Build the project
WORKDIR /celaeno
RUN cmake -H. -Bbuild -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=clang++
RUN cmake --build build

# Perform tests
## Search
RUN ./build/test/g_search_bfs
RUN ./build/test/g_search_dfs
RUN ./build/test/g_search_kahn
## Views
RUN ./build/test/g_views_depth
RUN ./build/test/g_views_proximity
## Operations
### Query
RUN ./build/test/g_operations_balance_paths
RUN ./build/test/g_operations_count_crossings
RUN ./build/test/g_operations_minimize_crossings
### Representations
RUN ./build/test/g_operations_incidence_barycenter
RUN ./build/test/g_representations_incidence
